{
  "name": "create-graphql-markdown-docs",
  "version": "0.1.1",
  "description": "Create a new GraphQL API documentation site with GraphQL Markdown and Nuxt or Docusaurus",
  "type": "module",
  "homepage": "https://graphql-markdown.dev",
  "bugs": {
    "url": "https://github.com/graphql-markdown/graphql-markdown/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graphql-markdown/graphql-markdown.git",
    "directory": "packages/create-graphql-markdown-docs"
  },
  "keywords": [
    "create",
    "nuxt",
    "docusaurus",
    "graphql",
    "documentation",
    "cli",
    "scaffold"
  ],
  "author": {
    "name": "Gregory Heitz"
  },
  "license": "MIT",
  "bin": {
    "create-graphql-markdown-docs": "./bin/create.mjs"
  },
  "scripts": {
    "build": "echo \"no build step — bin/, lib/ and templates/ ship as source\"",
    "lint": "eslint --config ../../packages/tooling-config/eslint/config.ts \"bin/**/*.mjs\" \"lib/**/*.mjs\" \"tests/**/*.ts\"",
    "lint:fix": "eslint --config ../../packages/tooling-config/eslint/config.ts \"bin/**/*.mjs\" \"lib/**/*.mjs\" \"tests/**/*.ts\" --fix",
    "prettier": "prettier \"bin/**/*.mjs\" \"lib/**/*.mjs\" \"tests/**/*.ts\" --check",
    "prettier:fix": "prettier \"bin/**/*.mjs\" \"lib/**/*.mjs\" \"tests/**/*.ts\" --write",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests tests/unit",
    "test:integration": "vitest run --passWithNoTests tests/integration",
    "test:ci": "vitest run --passWithNoTests --silent --sequence.shuffle",
    "test:e2e": "GQLMD_CLI_E2E=1 vitest run tests/integration/e2e-build.test.ts"
  },
  "files": [
    "bin",
    "lib",
    "templates"
  ],
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "graphql": "^16.8.0",
    "package-manager-detector": "^1.0.0"
  },
  "devDependencies": {
    "@graphql-markdown/tooling-config": "workspace:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
