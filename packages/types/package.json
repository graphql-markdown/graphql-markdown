{
  "name": "@graphql-markdown/types",
  "version": "1.17.0",
  "description": "Common types for @graphql-markdown packages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graphql-markdown/graphql-markdown.git",
    "directory": "packages/types"
  },
  "keywords": [
    "graphql-markdown",
    "types",
    "typescript"
  ],
  "author": "Gregory Heitz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/graphql-markdown/graphql-markdown/issues"
  },
  "homepage": "https://github.com/graphql-markdown/graphql-markdown#readme",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsgo --build",
    "lint": "eslint --config ../../packages/tooling-config/eslint/config.ts \"src/**/*.ts\"",
    "lint:fix": "eslint --config ../../packages/tooling-config/eslint/config.ts \"src/**/*.ts\" --fix",
    "prettier": "prettier README.md --check",
    "prettier:fix": "prettier README.md --write"
  },
  "dependencies": {
    "@graphql-tools/load": "catalog:graphql-tools",
    "@graphql-tools/utils": "catalog:graphql-tools",
    "graphql": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
