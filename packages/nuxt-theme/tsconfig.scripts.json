{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },

  "include": ["*.ts"],
  "exclude": ["app", "modules", "tests", ".nuxt", "node_modules"]
}
