{
  "name": "@graphql-markdown/telemetry",
  "homepage": "https://graphql-markdown.dev",
  "description": "Anonymous, opt-out usage telemetry for the GraphQL-Markdown CLI.",
  "bugs": {
    "url": "https://github.com/graphql-markdown/graphql-markdown/issues"
  },
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graphql-markdown/graphql-markdown.git",
    "directory": "packages/telemetry"
  },
  "author": {
    "name": "Gregory Heitz"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./schema": {
      "require": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      },
      "import": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      },
      "default": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "stryker": "stryker run",
    "clean": "tsgo --build --clean && rm -rf ./dist",
    "docs": "typedoc --options typedoc.config.mjs",
    "build": "tsgo --build",
    "lint": "eslint --config ../../packages/tooling-config/eslint/config.ts \"{src,tests}/**/*.{ts,js,json,gql}\"",
    "lint:fix": "eslint --config ../../packages/tooling-config/eslint/config.ts \"{src,tests}/**/*.{ts,js,json,gql}\" --fix",
    "prettier": "prettier \"{src,tests,assets}/**/*.{ts,js,json,md,gql}\" README.md --check",
    "prettier:fix": "prettier \"{src,tests,assets}/**/*.{ts,js,json,md,gql}\" README.md --write",
    "ts:check": "tsgo --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests tests/unit",
    "test:integration": "vitest run --passWithNoTests tests/integration",
    "test:ci": "vitest run --passWithNoTests --silent --sequence.shuffle",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@graphql-markdown/types": "workspace:^"
  },
  "devDependencies": {
    "@graphql-markdown/tooling-config": "workspace:^",
    "@stryker-mutator/api": "10.1.1"
  },
  "directories": {
    "test": "tests"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "typescript": {
    "definition": "dist/index.d.ts"
  },
  "files": [
    "dist"
  ]
}
