{
  "workspaces": {
    ".": {
      "entry": ["dangerfile.js", "config/*.js"],
      "project": ["config/**/*.js"],
      "eslint": {
        "config": ["packages/tooling-config/eslint/config.ts"]
      }
    },
    "packages/*": {
      "entry": ["vitest.config.mjs"],
      "project": ["**/*.ts!"]
    },
    "packages/types": {
      "ignoreDependencies": [
        "@graphql-tools/load",
        "@graphql-tools/utils",
        "graphql",
        "graphql-config"
      ]
    },
    "packages/docusaurus": {
      "entry": ["vitest.config.mjs"],
      "ignoreDependencies": ["@docusaurus/types"]
    },
    "packages/core": {
      "entry": ["vitest.config.mjs"],
      "ignoreDependencies": ["graphql-config"]
    },
    "packages/utils": {
      "entry": ["vitest.config.mjs"],
      "project": ["**/*.ts!"],
      "ignoreDependencies": ["prettier"]
    },
    "packages/nuxt-theme": {
      "entry": [
        "nuxt.config.ts",
        "content.config.ts",
        "generate.ts",
        "generate-docs.ts",
        "formatter.mjs",
        "swizzle.manifest.ts",
        "modules/*.ts",
        "vitest.config.mjs",
        "tests/global-setup.mjs",
        "app/components/*.vue",
        "app/composables/*.ts!",
        "app/utils/*.ts!"
      ],
      "ignore": [
        "tests/fixture/**",
        "tests/fixture-multi/**",
        "tests/fixture-flat/**"
      ],
      "ignoreDependencies": ["nuxt"]
    },
    "packages/create-graphql-markdown-docs": {
      "entry": ["bin/create.mjs!", "lib/**/*.mjs!", "vitest.config.mjs"],
      "ignore": ["templates/**"]
    },
    "packages/tooling-config": {
      "project": ["**/*.{ts,mts}!"],
      "entry": [
        "scripts/shared/package-names.mts",
        "eslint/config.ts",
        "vitest/base.mjs",
        "prettier/index.mjs",
        "scripts/build-packages.mts",
        "scripts/shared/dependencies-utils.mts",
        "scripts/publish-release.mts",
        "scripts/tarball-check.mts",
        "scripts/docs-api.mjs",
        "husky/prepare-husky.js",
        "stryker/stryker.conf.mjs",
        "typedoc/api.mjs",
        "typedoc/base.mjs",
        "typedoc/root.mjs",
        "typedoc/custom-frontmatter.mjs",
        "typedoc/no-media-plugin.mjs"
      ],
      "ignoreDependencies": [
        "@eslint/js",
        "@graphql-eslint/eslint-plugin",
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "eslint-config-prettier",
        "@vitest/eslint-plugin",
        "vitest",
        "eslint-plugin-jsonc",
        "eslint-plugin-mdx",
        "eslint-plugin-prettier",
        "eslint-plugin-tsdoc",
        "globals",
        "jsonc-eslint-parser"
      ]
    }
  },
  "ignoreDependencies": [
    "@docusaurus/logger",
    "commitizen",
    "danger",
    "husky"
  ],
  "vitest": {
    "config": ["packages/*/vitest.config.mjs"],
    "entry": ["**/tests/**/*.ts"]
  }
}
