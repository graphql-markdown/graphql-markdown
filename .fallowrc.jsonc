{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/refs/heads/main/schema.json",

  // Files loaded implicitly by CI tooling or TypeDoc — not imported statically
  // but still needed. Declaring them as entry points silences unused-file
  // false positives. Stryker and danger configs are dev tooling so they must
  // be declared explicitly. E2e specs are run via Earthfile (outside jest plugin
  // detection range) so they are declared here too, as are the CI tooling specs,
  // which run through their own vitest config (`tests/ci/vitest.config.mjs`)
  // rather than the workspace one.
  "entry": [
    "dangerfile.js",
    ".github/scripts/**",
    "**/stryker.conf.mjs",
    "packages/tooling-config/scripts/**",
    "packages/tooling-config/typedoc/**",
    "tests/ci/**",
    "tests/e2e/*/specs/*.spec.mjs",
    "tests/e2e/helpers/**",
    "packages/nuxt-theme/app/assets/css/main.css",
    "packages/nuxt-theme/generate-docs.ts",
    "packages/nuxt-theme/tests/global-setup.mjs",
    "packages/nuxt-theme/tests/fixture*/content.config.ts",
    "packages/nuxt-theme/tests/fixture*/generate-docs.ts",
    "packages/nuxt-theme/tests/fixture*/schema/*.graphql",
  ],

  // nuxt-theme is a Nuxt layer: its entries are wired by nuxt.config.ts (css),
  // vitest.config.mjs (globalSetup) and the Nuxt Content/CLI runtimes, none of
  // which fallow traces. The test fixtures extend the layer and override its
  // SiteHeader component, which looks like a package cycle (see package-cycle
  // under `rules`).

  // `vue` is provided by Nuxt, not listed in the layer's package.json.
  "ignoreUnresolvedImports": ["vue"],

  // formatter.mjs is loaded dynamically by @graphql-markdown/cli as a formatter
  // module; SwizzleEntry is the public type of the manifest.
  "ignoreExports": [
    {
      "file": "packages/nuxt-theme/formatter.mjs",
      "exports": ["*"],
    },
    {
      "file": "packages/nuxt-theme/swizzle.manifest.ts",
      "exports": ["SwizzleEntry"],
    },
    // Logger is both a named and the default export: the CLI and core import the
    // default, other consumers the named export.
    {
      "file": "packages/logger/src/index.ts",
      "exports": ["default"],
    },
  ],

  // website/ is a Docusaurus app outside the packages/* workspace —
  // its CSS-module exports and @docusaurus/* imports produce noise.
  // dist/ is build output. __data__/ holds test fixtures. The scaffolder templates
  // declare their dependencies in each template's own package.json (mirrors knip).
  // The CLI unit tests contain large inline snapshots that inflate function-size findings.
  "ignorePatterns": [
    "website/**",
    "packages/cli/tests/unit/index.test.ts",
    "**/dist/**",
    "**/__data__/**",
    "packages/create-graphql-markdown-docs/templates/**",
  ],

  // These dependencies are used without a static import that fallow can trace:
  //   @docusaurus/logger              — dynamically imported in logger tests via import(moduleName)
  //   cz-emoji                        — commitizen adapter (config.commitizen.path)
  //   typedoc-docusaurus-theme        — TypeDoc plugin string in typedoc config
  //   better-sqlite3, shiki           — declared by the nuxt-theme test fixture apps, which
  //                                     use them at runtime through the theme layer
  //                                     (Nuxt Content's SQLite driver, the layer's Shiki
  //                                     highlighting) without importing them
  //
  // custom-mdx-parser and mdx-parser-mock are not real packages: they are `vi.mock(...)`
  // virtual module names and fixture `formatter` values in the core generator tests,
  // standing in for a user-loaded formatter module.
  //
  // diff, lodash.filter and mutation-testing-metrics are used only by dangerfile.js
  // (Danger CI tooling). dangerfile.js is declared above as an `entry` point, which makes
  // it "reachable production code" and flags these dev-only deps. The root package.json
  // is private and never installed with `--prod`, so this is a false positive.
  //
  // @stryker-mutator/api is declared once in the root package.json, like the other test
  // tools. Each package's stryker.conf.mjs only imports its types in a JSDoc comment.
  // vite is the same case: packages/tooling-config/vitest only imports its types, and
  // it is installed with vitest.
  //
  // playwright is installed on demand (`npm install --no-save playwright`) by whoever
  // runs .github/scripts/demo-screenshots.mjs, as its header explains.
  "ignoreDependencies": [
    "@docusaurus/logger",
    "cz-emoji",
    "custom-mdx-parser",
    "mdx-parser-mock",
    "typedoc-docusaurus-theme",
    "diff",
    "lodash.filter",
    "mutation-testing-metrics",
    "better-sqlite3",
    "shiki",
    "@stryker-mutator/api",
    "vite",
    "playwright",
    // nuxt-theme's ts:check runs `nuxi typecheck`, which runs the vue-tsc binary
    // and never imports it.
    "vue-tsc",
    // Pinned JSR CLI and Deno runtime: publish-release.mts runs their binaries
    // from node_modules (Deno via DENO_BIN_PATH) and never imports them.
    "deno",
    "jsr",
  ],

  // Architecture boundaries: one zone per workspace package's shipped code (tests,
  // mocks and fixtures are left out). Each package may import only the workspace
  // packages it declares in its package.json (dependencies, peerDependencies or
  // optionalDependencies), so the declared dependency graph is enforced and a new
  // cross-package import must be declared, which also blocks layering cycles.
  // Update a rule together with the package.json it mirrors.
  "boundaries": {
    "zones": [
      {
        "name": "cli",
        "patterns": ["packages/cli/src/**"],
      },
      {
        "name": "core",
        "patterns": ["packages/core/src/**"],
      },
      {
        "name": "create-graphql-markdown-docs",
        "patterns": [
          "packages/create-graphql-markdown-docs/bin/**",
          "packages/create-graphql-markdown-docs/lib/**",
        ],
      },
      {
        "name": "diff",
        "patterns": ["packages/diff/src/**"],
      },
      {
        "name": "docusaurus",
        "patterns": ["packages/docusaurus/src/**"],
      },
      {
        "name": "formatters",
        "patterns": ["packages/formatters/src/**"],
      },
      {
        "name": "graphql",
        "patterns": ["packages/graphql/src/**"],
      },
      {
        "name": "helpers",
        "patterns": ["packages/helpers/src/**"],
      },
      {
        "name": "logger",
        "patterns": ["packages/logger/src/**"],
      },
      {
        "name": "nuxt-theme",
        "patterns": [
          "packages/nuxt-theme/app/**",
          "packages/nuxt-theme/bin/**",
          "packages/nuxt-theme/modules/**",
          "packages/nuxt-theme/{constants,content.config,generate,generate-docs,nuxt.config,swizzle.manifest}.ts",
          "packages/nuxt-theme/{formatter,swizzle.manifest}.mjs",
        ],
      },
      {
        "name": "printer-legacy",
        "patterns": ["packages/printer-legacy/src/**"],
      },
      {
        "name": "telemetry",
        "patterns": ["packages/telemetry/src/**"],
      },
      {
        "name": "tooling-config",
        "patterns": [
          "packages/tooling-config/{eslint,husky,prettier,scripts,vitest}/**",
        ],
      },
      {
        "name": "types",
        "patterns": ["packages/types/src/**"],
      },
      {
        "name": "utils",
        "patterns": ["packages/utils/src/**"],
      },
    ],
    "rules": [
      {
        "from": "cli",
        "allow": ["core", "logger", "telemetry", "types"],
      },
      {
        "from": "core",
        "allow": [
          "diff",
          "graphql",
          "helpers",
          "logger",
          "printer-legacy",
          "telemetry",
          "types",
          "utils",
        ],
      },
      {
        "from": "create-graphql-markdown-docs",
        "allow": ["telemetry"],
      },
      {
        "from": "diff",
        "allow": ["graphql", "types", "utils"],
      },
      {
        "from": "docusaurus",
        "allow": ["cli", "formatters", "logger", "types", "utils"],
      },
      {
        "from": "formatters",
        "allow": ["helpers", "types", "utils"],
      },
      {
        "from": "graphql",
        "allow": ["types", "utils"],
      },
      {
        "from": "helpers",
        "allow": ["graphql", "types", "utils"],
      },
      {
        "from": "logger",
        "allow": ["types"],
      },
      {
        "from": "nuxt-theme",
        "allow": ["cli"],
      },
      {
        "from": "printer-legacy",
        "allow": ["formatters", "graphql", "types", "utils"],
      },
      {
        "from": "telemetry",
        "allow": ["types"],
      },
      {
        "from": "tooling-config",
        "allow": [],
      },
      {
        "from": "types",
        "allow": [],
      },
      {
        "from": "utils",
        "allow": ["types"],
      },
    ],
  },

  // Class member false-positive suppressions.
  // IPrinter methods define an interface contract — no caller invokes them
  //   on the interface type directly.
  // CancellableEvent accessors are public event-system API used by lifecycle
  //   hooks at runtime (fallow can't trace accessor usage through dispatch).
  // Renderer.preCollectCategories is called in generator.ts via an instance
  //   variable; fallow misses the indirect call.
  // OptionBuilder methods (addDefault, addFromConfig, addFromCli, get, build,
  //   transformIf) are all called via fluent method chaining in config.ts;
  //   fallow can't trace instance-level chain calls.
  // CancellableEventEmitter.emitAsync is called in generator.ts and renderer.ts
  //   on the instance returned by getEvents(); fallow can't trace the call
  //   through the factory's return value.
  "usedClassMembers": [
    "init",
    "printHeader",
    "printDescription",
    "printCode",
    "printCustomDirectives",
    "printCustomTags",
    "printTypeMetadata",
    "printRelations",
    "printType",
    "defaultPrevented",
    "propagationStopped",
    "defaultAction",
    "runDefaultAction",
    "emitAsync",
    "preCollectCategories",
    "transformIf",
    "addDefault",
    "addFromConfig",
    "addFromCli",
    "get",
    "build",
  ],

  "production": false,

  "duplicates": {
    // mild is the default; raising minLines reduces formatter-preset noise
    // (8 formatters share intentionally similar structure in packages/formatters).
    "mode": "mild",
    "minLines": 8,
    // packages/formatters/src/**  — 8 preset implementations intentionally share structure
    // packages/formatters/tests/** — each formatter test file tests the same Formatter
    //   interface contract; structural similarity is by design, not copy-paste debt
    "ignore": [
      "packages/formatters/**",
      "packages/nuxt-theme/tests/fixture*/**",
    ],
  },

  "rules": {
    // unlisted-dependencies: tooling-config's ESLint/TypeDoc plugins are used
    //   transitively across all packages but listed only in tooling-config.
    "unlisted-dependencies": "warn",
    // package-cycle: nuxt-theme tests/fixture* extend the layer, and the layer's
    //   reference.vue resolves <SiteHeader> to the fixture's override. That is
    //   Nuxt layer resolution, not a real build-order dependency.
    "package-cycle": "off",
  },
}
